# Copy to .env. Every value below has a working default except DATABASE_URL,
# which is validated at boot — a missing or malformed value fails loudly rather
# than surfacing as `undefined` inside a request.

# --- required ---------------------------------------------------------------
DATABASE_URL=postgresql://tidemark:tidemark@127.0.0.1:5432/tidemark
# Signs the session cookie. Anything shorter than 16 characters is rejected.
SESSION_SECRET=change-me-to-a-long-random-string

# --- market data ------------------------------------------------------------
# Ordered preference. The pool falls through the list for whatever the previous
# provider could not answer, and the simulator is always appended as a last
# resort so the product degrades to clearly-labelled synthetic data rather than
# to a blank screen.
MARKET_PROVIDERS=simulated
# Live NSE prices with no API key, delayed ~15 minutes, simulator behind it for
# closed hours. Undocumented upstream, so the fallback matters.
# MARKET_PROVIDERS=yahoo,simulated
# MARKET_PROVIDERS=finnhub,simulated
# FINNHUB_API_KEY=

# --- simulator --------------------------------------------------------------
# Same seed, same market, on every machine.
SIM_SEED=20260904
SIM_VOLATILITY=1
# Keep generating sessions when NSE is shut, so the app is demonstrable at 3am.
SIM_ALWAYS_OPEN=true

# --- ingestion --------------------------------------------------------------
POLL_HOT_MS=5000        # somebody is looking at it right now
POLL_WARM_MS=60000      # on a watchlist, nobody watching
POLL_COLD_MS=900000     # on nobody's watchlist
QUOTE_BATCH_SIZE=50
WORKER_TICK_MS=1000
RUN_WORKER_IN_WEB=true  # false when the worker runs as its own process

# --- upstream resilience ----------------------------------------------------
PROVIDER_TIMEOUT_MS=4000
PROVIDER_MAX_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000

# --- storage ----------------------------------------------------------------
TAPE_LENGTH=180         # tick points kept per instrument for sparklines
PGSSL=false
